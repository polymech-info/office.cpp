{
  "name": "@polymech/office",
  "version": "0.1.0",
  "description": "pm-office OOXML library and CLI.",
  "scripts": {
    "config": "cmake --preset dev",
    "config:release": "cmake --preset release",
    "config:linux": "cmake --preset release-linux -G Ninja",
    "config:macos": "cmake --preset release-macos -G Ninja",
    "build": "cmake --preset dev && cmake --build --preset dev",
    "build:release": "cmake --preset release && cmake --build --preset release",
    "build:linux": "cmake --preset release-linux -G Ninja && cmake --build --preset release-linux",
    "build:macos": "cmake --preset release-macos -G Ninja && cmake --build --preset release-macos",
    "build:win32-mini": "cd apps/win32-mini && cmake --preset win32-mini && cmake --build --preset win32-mini",
    "clean": "cmake -E rm -rf build dist",
    "clean:all": "npm run clean && rm -rf $HOME/.mono-cpp-fetchcontent",
    "rebuild": "npm run clean && npm run build",
    "rebuild:release": "npm run clean && npm run build:release",
    "rebuild:macos": "npm run clean && npm run build:macos",
    "rebuild:linux": "npm run clean && npm run build:linux",
    "run": "node -e \"process.exit(0)\"",
    "run:help": "node tests/test-edit.mjs --help-only",
    "test": "node tests/test-edit.mjs",
    "test:hello": "node -e \"console.log('pm-office tests live in test-edit')\"",
    "test:office": "node tests/orchestrator/test-media.mjs --office-smoke-only",
    "install:linux": "bash scripts/install-lnx.sh",
    "install:macos": "bash osx/install.sh"
  },
  "keywords": ["cpp", "cmake", "cli", "boilerplate"],
  "author": "",
  "license": "MIT"
}
